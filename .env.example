# Copy to .env and supply your own LOCAL credentials. Never commit .env.
PROCESSING_POSTGRES_PASSWORD=
PROCESSING_DATABASE_NAME=processing
PROCESSING_DATABASE_USER=processing
PROCESSING_DATABASE_PASSWORD=
PROCESSING_APP_USER=processing_app
PROCESSING_APP_PASSWORD=
PROCESSING_POSTGRES_PORT=5432
PROCESSING_HTTP_PORT=8000
# Replace placeholders, percent-encoding special characters in URL passwords.
# Host: API uses app credentials; migrations use the database owner.
PROCESSING_DATABASE_URL=postgresql+psycopg://processing_app:<encoded-app-password>@127.0.0.1:5432/processing
PROCESSING_MIGRATION_DATABASE_URL=postgresql+psycopg://processing:<encoded-migration-password>@127.0.0.1:5432/processing
# Compose containers: use the postgres DNS name and its internal port.
PROCESSING_CONTAINER_DATABASE_URL=postgresql+psycopg://processing_app:<encoded-app-password>@postgres:5432/processing
PROCESSING_CONTAINER_MIGRATION_URL=postgresql+psycopg://processing:<encoded-migration-password>@postgres:5432/processing
# Tests must point to a separate database with a name ending in _test.
# Its owner needs CREATE SCHEMA; fixtures create/drop only their random schemas.
# PROCESSING_TEST_DATABASE_URL=postgresql+psycopg://<test-user>:<encoded-test-password>@127.0.0.1:5432/processing_test
