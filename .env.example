# Copy to .env and supply your own LOCAL credentials. Never commit .env.
PROCESSING_POSTGRES_PASSWORD=
PROCESSING_DATABASE_NAME=processing
PROCESSING_DATABASE_USER=processing
PROCESSING_DATABASE_PASSWORD=
PROCESSING_APP_USER=processing_app
PROCESSING_APP_PASSWORD=
PROCESSING_POSTGRES_PORT=5432
PROCESSING_HTTP_PORT=8000
PROCESSING_WORKER_METRICS_PORT=9000
# Replace placeholders, percent-encoding special characters in URL passwords.
# Host: API uses app credentials; migrations use the database owner.
PROCESSING_DATABASE_URL=postgresql+psycopg://processing_app:<encoded-app-password>@127.0.0.1:5432/processing
PROCESSING_MIGRATION_DATABASE_URL=postgresql+psycopg://processing:<encoded-migration-password>@127.0.0.1:5432/processing
# Compose containers: use the postgres DNS name and its internal port.
PROCESSING_CONTAINER_DATABASE_URL=postgresql+psycopg://processing_app:<encoded-app-password>@postgres:5432/processing
PROCESSING_CONTAINER_MIGRATION_URL=postgresql+psycopg://processing:<encoded-migration-password>@postgres:5432/processing

# Local RabbitMQ credentials are separate: the admin URL provisions the
# Processing worker account; the worker uses only its scoped AMQP credentials.
PROCESSING_AMQP_ADMIN_USER=processing_admin
PROCESSING_AMQP_ADMIN_PASSWORD=
PROCESSING_AMQP_WORKER_USER=processing_worker
PROCESSING_AMQP_WORKER_PASSWORD=
PROCESSING_AMQP_VHOST=processing
PROCESSING_AMQP_PORT=5672
PROCESSING_AMQP_MANAGEMENT_PORT=15672
PROCESSING_AMQP_URL=amqp://processing_worker:<encoded-worker-password>@127.0.0.1:5672/processing
PROCESSING_AMQP_ADMIN_URL=amqp://processing_admin:<encoded-admin-password>@127.0.0.1:5672/processing
PROCESSING_AMQP_ADMIN_HTTP_URL=http://processing_admin:<encoded-admin-password>@127.0.0.1:15672
# Compose containers use RabbitMQ's DNS name; the tool provisions only the
# input exchange in an isolated Processing environment when explicitly true.
PROCESSING_CONTAINER_AMQP_URL=amqp://processing_worker:<encoded-worker-password>@rabbitmq:5672/processing
PROCESSING_AMQP_CONTAINER_ADMIN_URL=amqp://processing_admin:<encoded-admin-password>@rabbitmq:5672/processing
PROCESSING_AMQP_CONTAINER_ADMIN_HTTP_URL=http://processing_admin:<encoded-admin-password>@rabbitmq:15672
PROCESSING_AMQP_PROVISION_INPUT_EXCHANGE=false
PROCESSING_AMQP_EXCHANGE=docpipe.events
PROCESSING_AMQP_EXCHANGE_TYPE=direct
PROCESSING_AMQP_ROUTING_KEY=document.received.v1
PROCESSING_AMQP_QUEUE=processing.document-received.v1
PROCESSING_AMQP_DLX=processing.dlx.v1
PROCESSING_AMQP_DLQ=processing.dead-letter.v1
PROCESSING_AMQP_DLQ_ROUTING_KEY=processing.rejected.v1
PROCESSING_AMQP_HEARTBEAT_SECONDS=30
# Tests must point to a separate database with a name ending in _test.
# Its owner needs CREATE SCHEMA; fixtures create/drop only their random schemas.
# PROCESSING_TEST_DATABASE_URL=postgresql+psycopg://<test-user>:<encoded-test-password>@127.0.0.1:5432/processing_test
# RabbitMQ integration tests use a disposable broker/vhost and credentials that
# can declare/delete only resources in that isolated test vhost.
# PROCESSING_AMQP_URL=amqp://<test-user>:<encoded-password>@127.0.0.1:5672/processing_test
# PROCESSING_RABBITMQ_CONTAINER_ID=<disposable-container-id-for-restart-test>
